@article{wilsonProgesteroneSignalingMyometrial2020,
  title = {Progesterone Signaling in Myometrial Cells: Role in Human Pregnancy and Parturition},
  shorttitle = {Progesterone Signaling in Myometrial Cells},
  author = {Wilson, Rachel A and Mesiano, Sam A},
  date = {2020-02-01},
  journaltitle = {Current Opinion in Physiology},
  shortjournal = {Current Opinion in Physiology},
  series = {Pregnancy and the {{Myometrium}}},
  volume = {13},
  pages = {117--122},
  issn = {2468-8673},
  doi = {10.1016/j.cophys.2019.09.007},
  url = {https://www.sciencedirect.com/science/article/pii/S2468867319301385},
  urldate = {2026-02-04},
  abstract = {The steroid hormone, progesterone, is necessary for the establishment, maintenance and success of pregnancy. Progesterone maintains pregnancy mainly by promoting myometrial relaxation. This occurs via its binding with the nuclear progesterone receptor (PR) isoforms PR-A and PR-B in uterine myometrial cells. Recent studies suggest that for most of pregnancy progesterone/PR signaling blocks labor by inhibiting myometrial cell responsiveness to pro-inflammatory stimuli (i.e. an anti-inflammatory effect). Human parturition involves a functional progesterone withdrawal whereby myometrial cell progesterone-PR anti-inflammatory activity is lost due to changes in PR transcriptional activity. Recent data suggest that parturition involves specific changes in myometrial cell PR-A activity which abrogates the progesterone-PR anti-inflammatory effects and is induced in myometrial cells when the extent of pro-inflammatory stimuli exceeds a threshold level. This model explains how stress/inflammation induces term and preterm parturition and is a plausible target for therapies to prevent preterm birth.},
  file = {/home/stafin/Zotero/storage/XIUAU22X/S2468867319301385.html}
}

