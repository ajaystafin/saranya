@article{akgulHyaluronanCervicalEpithelia2014,
  title = {Hyaluronan in Cervical Epithelia Protects against Infection-Mediated Preterm Birth},
  author = {Akgul, Yucel and Word, R. Ann and Ensign, Laura M. and Yamaguchi, Yu and Lydon, John and Hanes, Justin and Mahendroo, Mala},
  date = {2014-12},
  journaltitle = {The Journal of Clinical Investigation},
  shortjournal = {J Clin Invest},
  volume = {124},
  number = {12},
  eprint = {25384213},
  eprinttype = {pubmed},
  pages = {5481--5489},
  issn = {1558-8238},
  doi = {10.1172/JCI78765},
  abstract = {Increased synthesis of cervical hyaluronan (HA) from early to late pregnancy has long been proposed to play an essential role in disorganization of the collagen-rich extracellular matrix to allow for maximal compliance and dilation of the cervix during the birth process. Here, we show that HA is not essential for increased cervical distensibility during late pregnancy. Rather, cervicovaginal HA plays an unanticipated important role in epithelial barrier protection of the lower reproductive tract. Specifically, HA depletion in the cervix and vagina resulted in inappropriate differentiation of epithelial cells, increased epithelial and mucosal permeability, and strikingly increased preterm birth rates in a mouse model of ascending vaginal infection. Collectively, these findings revealed that although HA is not obligatory for cervical compliance, it is crucial for maintaining an epithelial and mucosal barrier to limit pathogen infiltration of the lower reproductive tract during pregnancy and thereby is protective against infection-mediated preterm birth.},
  langid = {english},
  pmcid = {PMC4348952},
  keywords = {Animals,Cervix Uteri,Epithelium,Female,Hyaluronic Acid,Mice,Mice Knockout,Pregnancy,Pregnancy Complications Infectious,Premature Birth,Vagina,Vaginosis Bacterial},
  file = {/home/stafin/Zotero/storage/4FZLEFQP/Akgul et al. - 2014 - Hyaluronan in cervical epithelia protects against infection-mediated preterm birth.pdf}
}

@article{akinsCervicalSofteningPregnancy2011,
  title = {Cervical Softening during Pregnancy: Regulated Changes in Collagen Cross-Linking and Composition of Matricellular Proteins in the Mouse},
  shorttitle = {Cervical Softening during Pregnancy},
  author = {Akins, Meredith L. and Luby-Phelps, Katherine and Bank, Ruud A. and Mahendroo, Mala},
  date = {2011-05},
  journaltitle = {Biology of Reproduction},
  shortjournal = {Biol Reprod},
  volume = {84},
  number = {5},
  eprint = {21248285},
  eprinttype = {pubmed},
  pages = {1053--1062},
  issn = {1529-7268},
  doi = {10.1095/biolreprod.110.089599},
  abstract = {A greater understanding of the parturition process is essential in the prevention of preterm birth, which occurs in 12.7\% of infants born in the United States annually. Cervical remodeling is a critical component of this process. Beginning early in pregnancy, remodeling requires cumulative, progressive changes in the cervical extracellular matrix (ECM) that result in reorganization of collagen fibril structure with a gradual loss of tensile strength. In the current study, we undertook a detailed biochemical analysis of factors in the cervix that modulate collagen structure during early mouse pregnancy, including expression of proteins involved in processing of procollagen, assembly of collagen fibrils, cross-link formation, and deposition of collagen in the ECM. Changes in these factors correlated with changes in the types of collagen cross-links formed and packing of collagen fibrils as measured by electron microscopy. Early in pregnancy there is a decline in expression of two matricellular proteins, thrombospondin 2 and tenascin C, as well as a decline in expression of lysyl hydroxylase, which is involved in cross-link formation. These changes are accompanied by a decline in both HP and LP cross-links by gestation Days 12 and 14, respectively, as well as a progressive increase in collagen fibril diameter. In contrast, collagen abundance remains constant over the course of pregnancy. We conclude that early changes in tensile strength during cervical softening result in part from changes in the number and type of collagen cross-links and are associated with a decline in expression of two matricellular proteins thrombospondin 2 and tenascin C.},
  langid = {english},
  pmcid = {PMC3080426},
  keywords = {Animals,Cervical Ripening,Collagen,Extracellular Matrix Proteins,Female,Fibrillar Collagens,Gene Expression Regulation Developmental,Isoenzymes,Mice,Mice 129 Strain,Mice Inbred C57BL,Microscopy Electron Transmission,Pregnancy,Pregnancy Proteins,Procollagen,Procollagen-Lysine 2-Oxoglutarate 5-Dioxygenase,Protein Processing Post-Translational,RNA Messenger,Tenascin,Thrombospondin 2,Thrombospondins},
  file = {/home/stafin/Zotero/storage/E43KUSXN/Akins et al. - 2011 - Cervical softening during pregnancy regulated changes in collagen cross-linking and composition of.pdf}
}

